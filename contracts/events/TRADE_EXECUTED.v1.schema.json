{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amc-os:contracts:events:TRADE_EXECUTED.v1.schema.json",
  "title": "TRADE_EXECUTED.v1",
  "description": "Payload of event TRADE_EXECUTED.v1. Producer: EXECUTION module. A fill (execution report) is received from a broker. Status: Draft (EA-007).",
