    "event_type": "TRADE_EXECUTED",
    "event_version": 1,
    "producer": "EXECUTION",
    "aggregate_type": "execution.execution",
    "event_class": "FINANCIAL",
    "data_classification": "CONFIDENTIAL"
  },
  "type": "object",
  "additionalProperties": false,
