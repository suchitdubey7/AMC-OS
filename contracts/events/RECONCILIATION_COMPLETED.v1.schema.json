{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amc-os:contracts:events:RECONCILIATION_COMPLETED.v1.schema.json",
  "title": "RECONCILIATION_COMPLETED.v1",
