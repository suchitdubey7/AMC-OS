{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amc-os:contracts:events:NAV_CORRECTION_APPROVED.v1.schema.json",
  "title": "NAV_CORRECTION_APPROVED.v1",
  "description": "Payload of event NAV_CORRECTION_APPROVED.v1. Producer: NAV module. A NAV correction is approved (WF-017). Status: Draft (EA-007).",
  "x-amc-os": {
