    "event_version": 1,
    "producer": "NAV",
    "aggregate_type": "nav.nav_correction",
    "event_class": "FINANCIAL",
    "data_classification": "CONFIDENTIAL"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "correction_id",
    "scheme_id",
    "nav_date",
    "original_nav_run_id",
    "corrected_nav_run_id",
    "plans",
    "approval_request_id"
  ],
  "properties": {
    "correction_id": {
      "$ref": "urn:amc-os:contracts:events:common.v1.schema.json#/$defs/uuid"
    },
    "scheme_id": {
      "$ref": "urn:amc-os:contracts:events:common.v1.schema.json#/$defs/uuid"
    },
    "nav_date": {
      "$ref": "urn:amc-os:contracts:events:common.v1.schema.json#/$defs/business_date"
