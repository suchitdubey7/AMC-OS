{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amc-os:contracts:events:SCHEME_ACTIVATED.v1.schema.json",
  "title": "SCHEME_ACTIVATED.v1",
  "description": "Payload of event SCHEME_ACTIVATED.v1. Producer: PRODUCT module. A scheme becomes ACTIVE after NFO allotment (WF-001). Status: Draft (EA-007).",
  "x-amc-os": {
    "event_type": "SCHEME_ACTIVATED",
    "event_version": 1,
    "producer": "PRODUCT",
    "aggregate_type": "product.scheme",
    "event_class": "REFERENCE",
    "data_classification": "INTERNAL"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scheme_id",
    "scheme_version_id",
    "plan_ids",
    "activation_date"
  ],
  "properties": {
    "scheme_id": {
      "$ref": "urn:amc-os:contracts:events:common.v1.schema.json#/$defs/uuid"
    },
    "scheme_version_id": {
      "$ref": "urn:amc-os:contracts:events:common.v1.schema.json#/$defs/uuid"
    },
    "plan_ids": {
      "type": "array",
      "items": {
        "$ref": "urn:amc-os:contracts:events:common.v1.schema.json#/$defs/uuid"
      },
      "minItems": 1
    },
    "activation_date": {
      "$ref": "urn:amc-os:contracts:events:common.v1.schema.json#/$defs/business_date"
    }
  }
}
